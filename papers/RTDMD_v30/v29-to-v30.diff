-\begin{equation}\label{eq:student-target}
- s_\theta(x_t,t)=\nabla_{x_t}\log p_{\theta,t}(x_t)
- =\frac{\alpha_t m_{\theta,t}(x_t)-x_t}{\sigma_t^2},
- \qquad m_{\theta,t}(x_t)=\E_\theta[X_{\rm src}\mid X_t=x_t].
-\end{equation}
-\end{block}
